{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drinks-mk2",
  "account_id": "08704241cb5ae85e6c85ea2be589f221",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "REVIEW_ID": "team001"
  },
  "secrets": {
    "required": [
      "REVIEW_KEY",
      "SEMANTIC_KEY",
      "LLM_KEY"
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "d1_databases": [
    {
      "binding": "TRACE_DB",
      "database_name": "drinks-mk2-traces",
      "database_id": "4d62b0bb-f049-41cc-b65a-cddab1cf8001"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SEMANTIC_BRIDGE",
        "class_name": "SemanticBridge"
      }
    ]
  },
  "migrations": [
    {
      "tag": "semantic-v1",
      "new_sqlite_classes": [
        "SemanticBridge"
      ]
    }
  ]
}
