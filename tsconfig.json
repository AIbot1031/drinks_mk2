{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "paths": {
      "drinks-directory": [
        "./data/nidin-directory.json"
      ]
    }
  },
  "include": [
    "worker/**/*.ts",
    "tests/**/*.ts",
    "worker-configuration.d.ts"
  ]
}
