{
  "name": "drinks-mk2",
  "version": "3.1.25",
  "private": true,
  "type": "module",
  "overrides": {
    "sharp": "^0.35.5"
  },
  "scripts": {
    "postinstall": "python3 scripts/build_catalog_flat.py",
    "precheck": "python3 scripts/build_catalog_flat.py",
    "pretest": "python3 scripts/build_catalog_flat.py",
    "predata:import": "python3 scripts/build_catalog_flat.py",
    "dev": "python3 scripts/build_catalog_flat.py && node scripts/build_catalog_runtime.mjs && wrangler dev",
    "build": "python3 scripts/build_catalog_flat.py && node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "types": "wrangler types",
    "deploy": "npm run build && wrangler deploy --minify",
    "deploy:check": "npm run build && wrangler deploy --dry-run --minify",
    "data:import": "python3 scripts/import_data.py",
    "trace:sample": "tsx scripts/export_trace.ts",
    "trace:export": "node scripts/export_cloud_traces.mjs",
    "db:local": "wrangler d1 migrations apply TRACE_DB --local",
    "db:remote": "wrangler d1 migrations apply TRACE_DB --remote"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.148.0"
  }
}
